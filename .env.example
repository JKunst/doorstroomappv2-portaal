# Doorstroomanalyse — environment variables
# Kopieer naar .env en vul echte waardes in. Commit .env nooit.

# Het JWT_SECRET van het portaal (Bovenbouw Succes). Moet identiek zijn aan
# wat het portaal gebruikt om tegel-tokens te ondertekenen.
PORTAAL_JWT_SECRET=

# Optionele salt voor de SHA-256 hash van Leerlingnummer. Zorgt dat hashes
# niet voorspelbaar zijn als iemand een lijst leerlingnummers heeft.
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LEERLING_HASH_SALT=
